# Copy this file to .env and fill in your own values

# MongoDB connection string (MongoDB Atlas or local mongod)
# Local example:   mongodb://127.0.0.1:27017/hospital_lims
# Atlas example:   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/hospital_lims
MONGO_URI=mongodb://127.0.0.1:27017/hospital_lims

# Port the API/app server runs on
PORT=8000

# Secret used to sign JWT auth tokens - use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret

# How long a login session stays valid
JWT_EXPIRES_IN=8h

# Optional: Anthropic API key to power richer AI result summaries.
# If left blank, the AI Insight feature automatically falls back to the
# built-in rule-based analyzer in utils/aiAnalysis.js (no key required).
ANTHROPIC_API_KEY=
